"cron-econ-audit.py - fleet-wide Hermes cron token economics audit.\n\nno_agent script: stdout becomes the job report (empty stdout = silent).\nMeasures per-profile cron token spend (sessions source='cron'), runs/day\nfrom jobs.json, success/fail from executions.db - last N days. Propose-only:\nnever edits jobs, only reports.\n\nEnv: CRON_ECON_DAYS (default 7), CRON_ECON_TOP (default 25)\n"
(import json)
(import os)
(import sqlite3)
(import sys)
(import time)
(import collections)
(setv PROFILES_DIR ((. os.path expanduser) "~/.hermes/profiles"))
(setv DAYS (int ((. os.environ get) "CRON_ECON_DAYS" "7")))
(setv TOP (int ((. os.environ get) "CRON_ECON_TOP" "25")))
(setv SELF "fleet-alloc")
(defn runs_per_day [s] (when (not (isinstance s dict)) (return 0.0)) (when (= (s.get "kind") "interval") (return (/ (* 24 60) (max (s.get "minutes" 0) 1)))) (when (= (s.get "kind") "once") (return 1.0)) (when (= (s.get "kind") "cron") (setv e ((. (s.get "expr" "") split))) (when (!= (len e) 5) (return 0.0)) (defn count [field lo hi] (when (= field "*") (return (+ (- hi lo) 1))) (setv tot 0) (for [part (field.split ",")] (if (in "/" part) (do (setv #(a step) (part.split "/" 1)) (setv step (int step)) (if (in a #("*" "")) (do (setv rng (range lo (+ hi 1)))) (do (if (in "-" a) (do (setv #(x y) (a.split "-" 1)) (setv rng (range (int x) (+ (int y) 1)))) (do (setv rng (range (int a) (+ hi 1))))))) (+= tot (len (lfor x rng :if (= (% (- x lo) step) 0) x)))) (do (if (in "-" part) (do (setv #(x y) (part.split "-" 1)) (+= tot (+ (- (int y) (int x)) 1))) (do (+= tot 1)))))) (return tot)) (return (float (* (count (get e 0) 0 59) (count (get e 1) 0 23))))) (return 0.0))
(defn collect [] (setv since (- (time.time) (* DAYS 86400))) (setv tok (collections.defaultdict (fn [] [0 0 0.0]))) (setv execs {}) (for [d (sorted (os.listdir PROFILES_DIR))] (setv prof d) (when (or (= prof SELF) (in ".bak" prof)) (continue)) (setv sd ((. os.path join) PROFILES_DIR d "state.db")) (when (not ((. os.path exists) sd)) (continue)) (try (setv con (sqlite3.connect (% "file:%s?mode=ro" sd) :uri True)) (try (setv rows ((. (con.execute "SELECT SUM(input_tokens), SUM(output_tokens), SUM(estimated_cost_usd) FROM sessions WHERE source='cron' AND started_at > ?" #(since)) fetchone))) (except [sqlite3.OperationalError] (con.close) (continue))) (when (and rows (or (get rows 0) (get rows 2))) (setv t (get tok prof)) (+= (get t 0) (or (get rows 0) 0)) (+= (get t 1) (or (get rows 1) 0)) (+= (get t 2) (or (get rows 2) 0.0))) (con.close) (except [sqlite3.Error] (continue)))) (for [d (sorted (os.listdir PROFILES_DIR))] (setv prof d) (when (or (= prof SELF) (in ".bak" prof)) (continue)) (setv edb ((. os.path join) PROFILES_DIR d "cron" "executions.db")) (when (not ((. os.path exists) edb)) (continue)) (try (setv con (sqlite3.connect (% "file:%s?mode=ro" edb) :uri True)) (setv st (dict ((. (con.execute "SELECT status, COUNT(*) FROM executions WHERE claimed_at > datetime('now', ?) GROUP BY status" #((% "-%d days" DAYS))) fetchall)))) (when st (setv (get execs prof) st)) (con.close) (except [sqlite3.Error] (continue)))) (return #(tok execs)))
(defn main [] (setv #(tok execs) (collect)) (setv cand []) (for [#(prof #(inp outp cost)) (tok.items)] (setv jf ((. os.path join) PROFILES_DIR prof "cron" "jobs.json")) (setv #(freq njobs) #(0.0 0)) (when ((. os.path exists) jf) (try (with [fh (open jf)] (setv jobs ((. (json.load fh) get) "jobs" []))) (setv jd (lfor j jobs :if (and (isinstance j dict) (j.get "enabled" True)) j)) (setv njobs (len jd)) (setv freq (sum (gfor j jd (runs_per_day (j.get "schedule" {}))))) (except [#(json.JSONDecodeError OSError)]))) (setv st (execs.get prof {})) (setv done (st.get "completed" 0)) (setv fail (st.get "failed" 0)) (setv total_tok (+ inp outp)) (cand.append (dict :prof prof :jobs njobs :runs_per_day freq :tok_week total_tok :tok_run (if done (/ total_tok done) 0) :cost_week cost :done done :fail fail :fail_rate (if (+ done fail) (/ fail (+ done fail)) None)))) (cand.sort :key (fn [c] (- (get c "tok_week")))) (setv tok_week (sum (gfor c cand (get c "tok_week")))) (setv cost_week (sum (gfor c cand (get c "cost_week")))) (setv lines [(% "## cron token economics - fleet audit (last %dd)" DAYS) (% "profiles measured: %d / cron tok: %s / est cost: $%.2f (~$%.2f/day)" #((len cand) (format (int tok_week) ",") cost_week (/ cost_week (max DAYS 1))))]) (lines.append "") (lines.append (% "## top %d by token spend" (min TOP (len cand)))) (lines.append "profile | runs/day | tok/run | tok | $ | done/fail") (for [c (cut cand TOP)] (setv fr (if (is-not (get c "fail_rate") None) (% "%.0f%%" (* (get c "fail_rate") 100)) "-")) (lines.append (% "%s | %.0f | %s | %s | $%.2f | %d/%d (%s)" #((get c "prof") (get c "runs_per_day") (format (int (get c "tok_run")) ",") (format (int (get c "tok_week")) ",") (get c "cost_week") (get c "done") (get c "fail") fr)))) (setv alerts (lfor c cand :if (or (and (is-not (get c "fail_rate") None) (>= (get c "fail_rate") 0.5) (>= (+ (get c "done") (get c "fail")) 5)) (and (> (get c "tok_run") 500000) (>= (get c "runs_per_day") 24))) c)) (when alerts (lines.append "") (lines.append (% "## alerts (%d)" (len alerts))) (for [c alerts] (if (and (is-not (get c "fail_rate") None) (>= (get c "fail_rate") 0.5)) (do (lines.append (% "%s: fail rate %.0f%% (%d/%d) - failing runs still burn tokens" #((get c "prof") (* (get c "fail_rate") 100) (get c "done") (get c "fail"))))) (do (lines.append (% "%s: %s tok/run x %.0f runs/day - freq x unit waste" #((get c "prof") (format (int (get c "tok_run")) ",") (get c "runs_per_day")))))))) (print ((. "\n" join) lines)) (setv ledger ((. os.path join) PROFILES_DIR SELF "workspace" "cron-econ-ledger.jsonl")) (os.makedirs ((. os.path dirname) ledger) :exist_ok True) (with [fh (open ledger "a")] (fh.write (+ (json.dumps (dict :ts (time.time) :days DAYS :total_tok (int tok_week) :cost (round cost_week 4) :profiles (len cand) :top (lfor c (cut cand 10) [(get c "prof") (int (get c "tok_week")) (round (get c "cost_week") 4) (get c "done") (get c "fail")]))) "\n"))))
(when (= __name__ "__main__") (sys.exit (main)))
