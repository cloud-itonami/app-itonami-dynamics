#:model{:id :germany-population-aging,
        :as-of "2026-11-12",
        :interpretation
        "2-stock Euler integration (dt 0.05yr x 10yr), dependency-free one-time oracle. "
        "Birth/death counts are Destatis-2024 actuals; total is Fortschreibung; elderly "
        "level is secondary-compiled; net migration is a residual; aging coefficient and "
        "elder-mortality multiple are sensitivity assumptions. Year-1 checked against "
        "the implied direction only.",
        :oracle {:script "oracle/germany_population_oracle_run.cljc (one-time oracle, not CI/gate)",
                 :runtime "basilisp, macOS arm64",
                 :source-edn "examples/germany-population-aging-scenarios.edn (mirror asserted by grep before run)"},
        :checkpoints-years [0 1 5 10],
        :scenarios
        {
         :baseline-2024-rates {:checkpoints {0 [83.58 19.0]}{1 [83.709 19.275]}{5 [84.219 20.264]}{10 [84.845 21.285]}}
         :low-migration {:checkpoints {0 [83.58 19.0]}{1 [83.479 19.274]}{5 [83.08 20.225]}{10 [82.59 21.141]}}
         :faster-aging {:checkpoints {0 [83.58 19.0]}{1 [83.709 19.59]}{5 [84.219 21.666]}{10 [84.845 23.733]}}
         }}
