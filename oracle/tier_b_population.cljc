;; AWAI-3384 — Tier B population models for every country/area, generated by
;; one procedure from UN WPP 2024 (examples/tier-b/wpp2024-tier-b-inputs.edn).
;;
;; Pure clojure.core: no host interop, no reader conditionals, no IO. Runs on
;; babashka and JVM Clojure. The engine is the same 2-stock Euler integration
;; as the Tier A population oracles (oracle/*_population_oracle_run.cljc); the
;; test feeds it every Tier A scenario and requires the published Tier A
;; results back, so the two are checked against each other.
;;
;; Tier B is a scenario, not a forecast. Tier A national models stay the deeper
;; source; differences between the two are reported, never reconciled.

(ns tier-b-population)

(def defaults
  "Modelling choices shared by every Tier B model."
  {:dt 0.05 :years 10.0 :checkpoints [0 1 5 10]
   :elder-death-multiple 3.0})   ; same assumption as the Tier A models

(defn- abs* [x] (if (neg? x) (- x) x))

(defn round-to [x decimals]
  (let [f (reduce * 1.0 (repeat decimals 10.0))]
    (/ (double (long (+ (* x f) 0.5))) f)))

(defn simulate
  "Euler integration of total population P and 65+ population E, identical to
   the Tier A oracles. Returns {checkpoint-year [P E]} rounded to decimals."
  [{:keys [p0 e0 dt years checkpoints birth-rate death-rate net-migration aging-coef elder-death-multiple]} decimals]
  (let [de (* elder-death-multiple death-rate)
        n (long (+ (/ years dt) 0.5))
        tol (+ (/ dt 2) 1e-12)]
    (loop [i 0 pop p0 eld e0 traj {0 [(round-to p0 decimals) (round-to e0 decimals)]}]
      (if (>= i n)
        traj
        (let [dp (+ (* (- birth-rate death-rate) pop) net-migration)
              de-flow (- (* aging-coef (- pop eld)) (* de eld))
              pop2 (max 0.0 (+ pop (* dp dt)))
              eld2 (max 0.0 (min pop2 (+ eld (* de-flow dt))))
              t (* (inc i) dt)
              hit (first (filter #(and (not (contains? traj %)) (< (abs* (- t %)) tol)) checkpoints))]
          (recur (inc i) pop2 eld2 (if hit (assoc traj hit [(round-to pop2 decimals) (round-to eld2 decimals)]) traj)))))))

(defn finite? [x] (and (number? x) (not (Double/isNaN (double x))) (not (Double/isInfinite (double x)))))

(def input-keys [:p2022 :p2023 :e2022 :e2023 :cbr2023 :cdr2023 :netm2023])

(defn derive-params
  "Model parameters for one country from WPP inputs. The aging coefficient is
   derived from the observed 2022->2023 change of the 65+ population with the
   assumed elder death multiple:
     ac = (E2023 - E2022 + m * d * E2022) / (P2022 - E2022)
   Returns {:status :ok :params ...} or {:status :incomplete|:aging-unidentified :reason ...}."
  [c]
  (let [missing (remove #(finite? (get c %)) input-keys)]
    (if (seq missing)
      {:status :incomplete :reason (vec missing)}
      (let [m (:elder-death-multiple defaults)
            dr (/ (:cdr2023 c) 1000.0)
            ac (/ (+ (- (:e2023 c) (:e2022 c)) (* m dr (:e2022 c))) (- (:p2022 c) (:e2022 c)))]
        (if (and (finite? ac) (pos? ac) (< ac 1.0))
          {:status :ok
           :params (merge defaults
                          {:p0 (:p2023 c) :e0 (:e2023 c)
                           :birth-rate (/ (:cbr2023 c) 1000.0) :death-rate dr
                           :net-migration (:netm2023 c) :aging-coef ac})}
          {:status :aging-unidentified :reason {:aging-coef ac}})))))

(defn generate
  "Every country -> {:status ... :params ... :baseline checkpoints (3 decimals)}."
  [inputs]
  (into (sorted-map)
        (for [[iso c] (:countries inputs)]
          (let [{:keys [status params] :as r} (derive-params c)]
            [iso (cond-> (assoc r :name (:name c) :p2023 (:p2023 c))
                   (= :ok status) (assoc :baseline (simulate params 3)))]))))

(defn coverage
  "Share of the WPP world population (same panel, same year) covered by
   countries that got a model."
  [inputs models]
  (/ (reduce + 0.0 (for [[_ m] models :when (= :ok (:status m))] (:p2023 m)))
     (get-in inputs [:world :p2023])))
