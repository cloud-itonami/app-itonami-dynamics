(ns run-tests
  (:require [cljs.test :as t]
            [dynamics.core-test]
            [dynamics.provenance-test]
            [dynamics.xmile-test]
            [dynamics.sysml-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (when-not (t/successful? m)
    (js/process.exit 1)))

(t/run-tests 'dynamics.core-test 'dynamics.provenance-test 'dynamics.xmile-test 'dynamics.sysml-test)
